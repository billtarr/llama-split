+// [LAYER-SPLIT] gather rows [off, off+len) of dim0 of a dim0-sliced tensor.
+// the file holds the full tensor, so each row is copied out separately with the file's row stride.
+bool llama_model_loader::load_dim0_slice(struct ggml_tensor * dst, int64_t off, int64_t len) const {
+    const auto * w = get_weight(ggml_get_name(dst));
+    if (w == nullptr) {
+        return false;
+    }
+
+    const ggml_tensor * src = w->tensor;
+
+    const size_t row_full = ggml_row_size(src->type, src->ne[0]);
+    const size_t row_part = ggml_row_size(src->type, len);
+    const size_t byte_off = ggml_row_size(src->type, off);
+
+    GGML_ASSERT(row_part == dst->nb[1]);
+
+    const int64_t n_rows = src->ne[1];
+    const int64_t rows_per_chunk = std::max<int64_t>(1, (int64_t) (8u << 20) / (int64_t) row_part);
+
+    const uint8_t * base = use_mmap ? (const uint8_t *) mappings.at(w->idx)->addr() + w->offs : nullptr;
+
+    std::vector<uint8_t> stage((size_t) row_part * (size_t) rows_per_chunk);
+
+    for (int64_t r0 = 0; r0 < n_rows; r0 += rows_per_chunk) {
+        const int64_t n = std::min(rows_per_chunk, n_rows - r0);
+
+        for (int64_t r = 0; r < n; ++r) {
+            uint8_t * d = stage.data() + (size_t) r * row_part;
+            const size_t off_in_tensor = (size_t) (r0 + r) * row_full + byte_off;
+
+            if (base != nullptr) {
+                memcpy(d, base + off_in_tensor, row_part);
+            } else {
+                const auto & file = files.at(w->idx);
+                file->seek(w->offs + off_in_tensor, SEEK_SET);
+                file->read_raw(d, row_part);
+            }
+        }
+
+        ggml_backend_tensor_set(dst, stage.data(), (size_t) r0 * row_part, (size_t) n * row_part);
+    }
+
+    return true;
+}
