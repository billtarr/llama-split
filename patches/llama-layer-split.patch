+// [LAYER-SPLIT] see src/llama-model.h
+static int g_layer_split_first = -1;
+static int g_layer_split_last  = -1;
+
+static void llm_layer_split_parse() {
+    if (g_layer_split_first >= 0) {
+        return;
+    }
+
+    g_layer_split_first = 0;
+    g_layer_split_last  = -1;
+
+    const char * env = getenv("LLAMA_LAYER_SPLIT");
+    if (!env || !*env) {
+        return;
+    }
+
+    int a = 0, b = 0;
+    if (sscanf(env, "%d:%d", &a, &b) == 2 && a >= 0 && b > a) {
+        g_layer_split_first = a;
+        g_layer_split_last  = b;
+        LLAMA_LOG_INFO("%s: layer split enabled: [%d, %d)\n", __func__, a, b);
+    } else {
+        LLAMA_LOG_WARN("%s: invalid LLAMA_LAYER_SPLIT '%s' (expected 'first:last'), ignored\n", __func__, env);
+    }
+}
+
+int llm_layer_split_first() {
+    llm_layer_split_parse();
+    return g_layer_split_first;
+}
+
+int llm_layer_split_last(int n_layer) {
+    llm_layer_split_parse();
+    if (g_layer_split_last < 0 || g_layer_split_last > n_layer) {
+        return n_layer;
+    }
+    return g_layer_split_last;
+}
